# Minutes desktop — environment configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Loaded automatically on app startup for local dev (see src-tauri/src/lib.rs).
# Release builds embed DESKSEC_API_URL / DESKSEC_TOKEN from CI at compile time;
# embedded values always win — these are ignored in shipped apps.
#
# Default transcription is **online** via your Minutes server (Deepgram on the
# server). On-device Whisper is optional in Settings — no extra client keys.
# Summaries also use the server (Fireworks AI key lives on the server only).
# See desksec-server/.env.example for DEEPGRAM_API_KEY and FIREWORKS_API_KEY.

# Base URL of your Minutes server (summaries + online transcription).
DESKSEC_API_URL=http://localhost:8787

# Access token issued by the server (must match one of the server's CLIENT_TOKENS).
DESKSEC_TOKEN=your-desksec-token-here
